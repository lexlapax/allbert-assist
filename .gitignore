# The directory Mix will write compiled artifacts to.
# Unanchored: running `mix` from inside an umbrella child (apps/<app>) creates a
# nested _build there, which a root-anchored `/_build/` does not cover -- those
# .beam files were untracked AND unignored, so `git add -A` could commit them.
_build/

# If you run "mix test --cover", coverage assets end up here.
cover/

# The directory Mix downloads your dependencies sources to. Unanchored for the
# same umbrella-child reason as _build/.
deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Local Allbert runtime data.
/var/allbert/memory/

# Raw local release-validation transcripts can contain ANSI control sequences
# and machine-local paths. Commit redacted evidence notes instead.
/docs/release-evidence/**/*.log

# OS-generated files (e.g. from macOS Finder, Windows Explorer).
.DS_Store
Thumbs.db

# Database files
*.db
*.db-*

# Local environment (API keys etc.)
.env
.env.*
!.env.example

# Plugin-owned Node dependencies.
/plugins/allbert.browser/priv/playwright_bridge/node_modules/

# Dialyzer PLTs
/priv/plts/
*.plt
*.plt.hash

# Coverage reports
excoveralls/

# Compiled BEAM artifacts, wherever a stray build lands them.
*.beam
*.app

# Local Claude Code workspace (worktrees, local settings, agent scratch).
# Keep the entire `.claude/` directory local to each machine; selectively
# allow specific shared files if needed.
# Excludes the contents rather than the directory: git does not descend into an
# excluded directory, so a wholesale `/.claude/` would make the exception below
# unreachable.
/.claude/*

# Shared exception: the project-scoped agents are project configuration, not
# machine configuration. AGENTS.md routes model work to them by name, so they
# travel with the repository exactly as `.codex/agents/` does.
!/.claude/agents/

# Test-run metrics raw store (v1.0.2 M8.1); the committed summary lives in
# docs/validation/test-metrics/.
/.test_metrics/
